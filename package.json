{
  "name": "omp-link",
  "version": "3.3.0",
  "description": "Multi-machine and Tailnet-aware peer-hosted coordination network with TLS 1.3 Mutual Authentication, SPKI Pinning, Scoped Capabilities, Structured RPC, and Quarantined File Transfer for Oh-My-Pi and Pi.",
  "type": "module",
  "author": "alvivar",
  "license": "MIT",
  "bin": {
    "omp-link": "bin/omp-link.mjs",
    "pi-link": "bin/pi-link.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/security.test.mjs",
    "test:integration": "node --import tsx --test tests/integration/**/*.test.mjs",
    "test:fuzz": "node --import tsx --test tests/fuzz/**/*.test.mjs",
    "ci": "npm run typecheck && npm test && npm run test:integration && npm run test:fuzz",
    "setup": "./setup.sh"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "index.ts",
    "AGENT.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "setup.sh",
    "link.example.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsbonsai/omp-link.git"
  },
  "keywords": [
    "omp-link",
    "pi-package",
    "pi",
    "omp",
    "oh-my-pi",
    "link",
    "tailscale",
    "tailnet",
    "websocket",
    "terminal",
    "multi-agent",
    "swarm"
  ],
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typebox": "^1.3.28",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
